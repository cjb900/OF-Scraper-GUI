# Copy this file to .env and adjust as needed.

# Port ComfyUI listens on (host side). Change if 8188 is already in use.
COMFYUI_PORT=8188

# HuggingFace token — only needed if you want to download gated/private models.
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
